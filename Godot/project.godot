; Engine configuration file.
; Rừng Thì Thầm in 3D (Godot 4.7). The Unity game in ../Assets stays the live game until this
; one catches up; see ../Docs/Godot.md.

config_version=5

[application]

config/name="Rừng Thì Thầm 3D"
config/description="Grinding action RPG in one seamless world, seen over the shoulder like Shadow of the Colossus."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controls="*res://scripts/core/controls.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/Inter-SemiBold.ttf"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="hero"
3d_physics/layer_3="enemy"
3d_physics/layer_4="colossus"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.62, 0.68, 0.72, 1)
